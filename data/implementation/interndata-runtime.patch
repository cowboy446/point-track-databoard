+    def _advance_replay_kinematics(self):
+        """Build articulated robot link transforms, then restore render state.
+
+        The Lift2 USD contains duplicate link names across its two arms.  In
+        Isaac Sim 4.1, teleporting its articulation and only calling Fabric's
+        update leaves those robot link transforms stale for rendering.  A
+        single physics tick computes the forward kinematics correctly.
+
+        That tick is *not* the state being rendered: immediately afterwards we
+        restore every recorded robot/object root and joint state and clear
+        velocities, then publish the restored state without another
+        integration.  Thus passive robot joints and dynamic objects cannot
+        acquire drift between the plan frame and the RGB capture.
+        """
+        self.world.step(render=False)
+        # The FK tick can move passive/mimic finger DOFs by slightly more than
+        # 1e-3 even with drives, gravity and contacts disabled.  Reapply the
+        # authoritative plan vector after FK, just as object state is restored
+        # below; update_transformations then publishes the exact articulation
+        # state without integrating it a second time.
+        self._restore_recorded_robot_root_states()
+        self._restore_recorded_robot_joint_states()
+        self._restore_recorded_object_states()
+        self._publish_restored_object_transforms()
+
+    def _publish_restored_object_transforms(self):
+        """Publish restored object transforms without another physics tick.
+
+        The preceding kinematic tick has already updated robot links.  This
+        call places the recorded object root/joint state into PhysX's fast
+        cache, without integrating it.  The one normal ``world.render`` in
+        the capture path then performs Fabric's update and consumes that cache.
+        Writing the same transforms to USD or updating Fabric here as well is
+        redundant and adds a per-frame synchronization pass.
