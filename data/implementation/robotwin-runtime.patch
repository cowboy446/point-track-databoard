diff --git a/upstream/envs/robot/planner.py b/deployed/envs/robot/planner.py
index 21ae432..320dacd 100644
--- a/upstream/envs/robot/planner.py
+++ b/deployed/envs/robot/planner.py
@@ -274,6 +274,21 @@ except Exception as e:
     print('[planner.py]: Something wrong happened when importing CuroboPlanner! Please check if Curobo is installed correctly. If the problem still exists, you can install Curobo from https://github.com/NVlabs/curobo manually.')
     print('Exception traceback:')
     traceback.print_exc()
+    class CuroboPlanner:
+        """No-op planner used only for replay; recorded joint paths need no planning."""
+        def __init__(self, *args, **kwargs):
+            pass
+        def plan_grippers(self, now_val, target_val):
+            now_val = float(now_val); target_val = float(target_val)
+            n = max(1, int(abs(target_val - now_val) / 0.02))
+            return {"per_step": 1, "result": np.linspace(now_val, target_val, n + 1)[1:], "num_step": n}
+        def plan_batch(self, curr_joint_pos, target_pose_list, **kwargs):
+            n = len(target_pose_list)
+            q = np.asarray(curr_joint_pos, dtype=float)
+            return {"status": ["Success"] * n, "position": [np.tile(q, (1, 1)) for _ in range(n)]}
+        def plan_path(self, curr_joint_pos, target_gripper_pose, **kwargs):
+            q = np.asarray(curr_joint_pos, dtype=float)
+            return {"status": "Success", "position": np.tile(q, (2, 1))}
 
 
