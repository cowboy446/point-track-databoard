+    def _lock_replay_object_roots(self):
+        """Make replayed object roots kinematic before the FK update tick.
+
+        Render-only replay teleports a robot to its recorded configuration so
+        that Isaac Sim can rebuild the robot-link transforms.  That requires
+        one PhysX tick on Isaac Sim 4.1 for the Lift2 asset, but the tick must
+        not be allowed to turn an RGB replay into a new physical simulation.
+
+        The saved state is authoritative in this mode.  Locking the physical
+        root of every recorded object prevents gravity and robot contacts from
+        translating an object during that otherwise-necessary tick.  Articulated
+        objects retain their recorded joint positions; only their base/root is
+        made kinematic.
+        """
+        changed = False
+        for obj in self.objs.values():
+            # ArticulatedObject exposes the actual physical base separately
+            # from its articulation-root Xform.  A regular rigid object uses
+            # its prim path directly.
+            candidate_paths = [
+                getattr(obj, "object_base_path", None),
+                getattr(obj, "prim_path", None),
+            ]
+            for prim_path in candidate_paths:
+                if not prim_path or str(prim_path) in self._locked_replay_object_paths:
+                    continue
+                prim = get_prim_at_path(str(prim_path))
+                if not prim or not prim.IsValid() or not prim.HasAPI(UsdPhysics.RigidBodyAPI):
+                    continue
+
+                rigid_body = UsdPhysics.RigidBodyAPI(prim)
+                kinematic_attr = rigid_body.GetKinematicEnabledAttr()
+                if not kinematic_attr:
+                    kinematic_attr = rigid_body.CreateKinematicEnabledAttr()
+                kinematic_attr.Set(True)
+                self._locked_replay_object_paths.add(str(prim_path))
+                changed = True
+                break
+
+        if changed:
+            # Deliver the USD property edits to PhysX before replay starts.
+            # render() does not advance physics.
+            self.world.render()
